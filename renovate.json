{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": [
		"config:recommended"
	],
	"platformAutomerge": true,
	"rebaseWhen": "behind-base-branch",
	"postUpdateOptions": [
		"pnpmDedupe"
	],
	"lockFileMaintenance": {
		"enabled": true,
		"automerge": true
	},
	"minimumReleaseAge": "1 day",
	"packageRules": [
		{
			"description": "automerge everything except major once checks pass",
			"matchUpdateTypes": [
				"minor",
				"patch",
				"pin",
				"digest"
			],
			"automerge": true
		},
		{
			"description": "group mise tool bumps",
			"matchManagers": [
				"mise"
			],
			"groupName": "mise tools"
		},
		{
			"description": "group production minor/patch",
			"matchManagers": [
				"npm"
			],
			"matchDepTypes": [
				"dependencies"
			],
			"matchUpdateTypes": [
				"minor",
				"patch"
			],
			"groupName": "production dependencies (non-major)"
		},
		{
			"description": "group dev minor/patch",
			"matchManagers": [
				"npm"
			],
			"matchDepTypes": [
				"devDependencies"
			],
			"matchUpdateTypes": [
				"minor",
				"patch"
			],
			"groupName": "devDependencies (non-major)"
		},
		{
			"description": "wait 7 days before major PRs",
			"matchUpdateTypes": [
				"major"
			],
			"minimumReleaseAge": "7 days"
		},
		{
			"description": "mirror old dependabot ignore",
			"matchPackageNames": [
				"typescript"
			],
			"matchUpdateTypes": [
				"major"
			],
			"enabled": false
		}
	]
}
